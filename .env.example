# Lauris Learn — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API

# Public URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key (safe to expose to browser — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SECRET, server-side only, bypasses RLS
# NEVER expose this in client code or commit it to git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── App ──────────────────────────────────────────────────────────────────────
# The public base URL of the app (used for invite links, email redirects,
# password-reset callbacks, and parent-guardian invite links). MUST match the
# domain you serve from — Supabase will only redirect to URLs in its allow-list.
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
#
# After changing this in production, also add `${NEXT_PUBLIC_APP_URL}/auth/callback`
# to Supabase Dashboard → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Local Tunnel (development only) ─────────────────────────────────────────
# Set to your ngrok / tunnel domain if testing on mobile devices or webhooks
# Leave blank in production
NGROK_DOMAIN=

# ─── IEP Evidence Assistant ───────────────────────────────────────────────────
# OpenAI API key — server-side only, NEVER expose to the browser
# Get yours at: https://platform.openai.com/api-keys
# Note: API billing is separate from ChatGPT subscriptions — requires a paid API account.
OPENAI_API_KEY=

# Extraction provider for uploaded evidence files
# Options: openai | none
# openai_vision is accepted as an alias for openai (backward compat)
IEP_EXTRACTION_PROVIDER=openai

# AI summarization provider (converts extracted text into IEP field suggestions)
# Options: openai | none
# openai_gpt4 is accepted as an alias for openai (backward compat)
IEP_AI_PROVIDER=openai

# Enable image OCR (required for JPEG/PNG/WebP uploads to produce suggestions)
# Set to false to skip OCR and accept uploads without text extraction
REPORT_OCR_ENABLED=true

# Enable AI summarization step
# Set to false to store extracted text only, without generating IEP suggestions
REPORT_AI_SUMMARY_ENABLED=true

# ── Optional: override the OpenAI model used per task (safe defaults below) ──
# Image OCR extraction (JPEG, PNG, WebP)
OPENAI_IEP_IMAGE_MODEL=gpt-4o-mini
# PDF extraction via Responses API file input
OPENAI_IEP_PDF_MODEL=gpt-4.1-mini
# IEP suggestion summarization
OPENAI_IEP_SUMMARY_MODEL=gpt-4.1-mini
